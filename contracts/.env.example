# Funded key for the target testnet. Base Sepolia faucets:
#   https://portal.cdp.coinbase.com/products/faucet   (ETH)
#   https://faucet.circle.com                         (USDC)
DEPLOYER_PRIVATE_KEY=

# Trusted dispute settler. Leave empty to deploy with no arbitration path at all — disputes then
# end only by mutual concession. See the trust model in docs/VAULTED.md.
ARBITER_ADDRESS=

# Stablecoin to escrow. Defaults to the canonical USDC for known chains (scripts/tokens.js);
# the deploy script verifies the symbol and decimals on chain before proceeding.
# TOKEN_ADDRESS=

# RPC overrides (each network has a public default)
# BASE_SEPOLIA_RPC_URL=
# BSC_TESTNET_RPC_URL=
# SEPOLIA_RPC_URL=

# For `npm run verify:baseSepolia`
ETHERSCAN_API_KEY=
