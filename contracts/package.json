{
  "name": "vaulted-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Vaulted escrow protocol \u2014 Solidity contracts, tests and deployment",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:baseSepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:bscTestnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:baseSepolia": "hardhat run scripts/verify.js --network baseSepolia",
    "verify:bscTestnet": "hardhat run scripts/verify.js --network bscTestnet",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "export-abi": "node scripts/export-abi.js",
    "id-vectors": "hardhat run scripts/emit-id-vector.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "mocha": "^11.8.0",
    "solc": "0.8.28",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
