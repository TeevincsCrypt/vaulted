{
  "name": "vaulted",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "Trustless escrow payment links for freelancers",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:baseline": "prisma migrate resolve --applied 20260822093000_init",
    "db:push": "prisma db push",
    "check:escrow-id": "tsx scripts/check-escrow-id-vector.mjs",
    "e2e:local": "tsx scripts/e2e-invoice-flow.mjs",
    "seed:local": "tsx scripts/seed-local-chain.mjs",
    "typecheck": "tsc --noEmit",
    "check:adapters": "tsx scripts/check-adapters.mjs",
    "check": "npm run typecheck && npm run check:escrow-id && npm run check:adapters"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "prisma": "6.19.3",
    "react": "^19",
    "react-dom": "^19",
    "viem": "^2.55.13",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
