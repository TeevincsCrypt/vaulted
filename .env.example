# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# Chain the app talks to. Optional when exactly one deployment is recorded in
# contracts/deployments — the app picks that one.
NEXT_PUBLIC_CHAIN_ID=84532

# Overrides for the addresses recorded by the deploy script. Leave unset to use
# contracts/deployments/<chainId>.json. Never point these at an address that has
# not actually been deployed — the UI reports "not deployed" instead, on purpose.
# NEXT_PUBLIC_ESCROW_ADDRESS=0x...
# NEXT_PUBLIC_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_TOKEN_SYMBOL=USDC
# NEXT_PUBLIC_TOKEN_DECIMALS=6

# Custom RPC for reads. Falls back to the chain's public endpoint.
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Server-only RPC, preferred over NEXT_PUBLIC_RPC_URL for reads made on the server.
# Use this one when the endpoint carries a provider API key — it never reaches the browser.
# RPC_URL=

# WalletConnect — REQUIRED to connect without a browser extension (mobile wallets, QR).
# Free project id from https://cloud.reown.com. Without it only injected extensions can connect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Accounts (Sign in with X/Twitter)
# ---------------------------------------------------------------------------
# Random string, 32+ characters. Signs session cookies — there is no default, and sign-in is
# disabled until it is set. Generate with: openssl rand -base64 48
AUTH_SECRET=

# From an X/Twitter app with OAuth 2.0 enabled (https://developer.x.com).
# Register the callback exactly as: <your origin>/api/auth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Only needed when the public origin differs from the request host (custom domain behind a proxy).
# The OAuth callback is derived from this when set.
# NEXT_PUBLIC_APP_URL=https://vaulted.app

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/vaulted?schema=public"
