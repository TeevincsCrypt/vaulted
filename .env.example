# ---------------------------------------------------------------------------
# Networks
# ---------------------------------------------------------------------------
# Production is Base Mainnet (escrow + payments) and Solana Mainnet (payments).
# Testnets are invisible unless this is set to "development" — a production build
# cannot offer Sepolia as somewhere to move real money.
# NEXT_PUBLIC_VAULTED_ENV=development

# THE ONE VALUE THAT TURNS ESCROW ON.
# VaultedEscrow is not deployed to Base Mainnet yet. Deploy it, then set its address
# here and jobs/escrowed invoices start working on Base. Until then Base is
# "payments only": payment links settle, escrow does not.
# NEXT_PUBLIC_ESCROW_ADDRESS_8453=0x...

# Optional per-network overrides. Defaults are Circle's own USDC on each network
# and the public RPC. Set a paid RPC in production — the public ones are rate limited.
# NEXT_PUBLIC_TOKEN_ADDRESS_8453=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# NEXT_PUBLIC_RPC_URL_8453=https://mainnet.base.org
# NEXT_PUBLIC_TOKEN_ADDRESS_SOLANA=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# NEXT_PUBLIC_RPC_URL_SOLANA=https://api.mainnet-beta.solana.com

# Development only, alongside NEXT_PUBLIC_VAULTED_ENV=development.
# NEXT_PUBLIC_ESCROW_ADDRESS_84532=0x...
# NEXT_PUBLIC_RPC_URL_84532=https://sepolia.base.org

# Pins the EVM network escrow runs on. Leave unset: the registry picks Base Mainnet.
# Only useful for pointing a build at one specific network.
# NEXT_PUBLIC_CHAIN_ID=8453

# Server-only RPC, preferred over the public ones for reads made on the server.
# Use this when the endpoint carries a provider API key — it never reaches the browser.
# RPC_URL=

# ---------------------------------------------------------------------------
# Accounts and wallets (Privy — sign in with X, embedded wallets)
# ---------------------------------------------------------------------------
# Random string, 32+ characters. Signs session cookies — there is no default, and sign-in is
# disabled until it is set. Generate with: openssl rand -base64 48
AUTH_SECRET=

# From a Privy app at https://dashboard.privy.io. Enable Twitter/X as a login method and turn on
# BOTH Ethereum and Solana embedded wallets. Add your origin to the app's allowed domains, or the
# modal will not open. The app id is public by design; the secret must never get a NEXT_PUBLIC_ name.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Only needed when the public origin differs from the request host (custom domain behind a proxy).
# NEXT_PUBLIC_APP_URL=https://vaulted-roan.vercel.app

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/vaulted?schema=public"
