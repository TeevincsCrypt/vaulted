# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# Chain the app talks to. Optional when exactly one deployment is recorded in
# contracts/deployments — the app picks that one.
NEXT_PUBLIC_CHAIN_ID=84532

# Overrides for the addresses recorded by the deploy script. Leave unset to use
# contracts/deployments/<chainId>.json. Never point these at an address that has
# not actually been deployed — the UI reports "not deployed" instead, on purpose.
# NEXT_PUBLIC_ESCROW_ADDRESS=0x...
# NEXT_PUBLIC_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_TOKEN_SYMBOL=USDC
# NEXT_PUBLIC_TOKEN_DECIMALS=6

# Custom RPC for reads. Falls back to the chain's public endpoint.
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# WalletConnect (optional; injected wallets work without it)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/vaulted?schema=public"
