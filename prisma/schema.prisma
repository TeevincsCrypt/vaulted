generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A Vaulted payment request.
///
/// This row is metadata and a cache — never an authority. Escrow status and amounts live on chain;
/// `indexedStatus` is only the last value observed there, and the UI reads the contract directly
/// rather than trusting it. There is deliberately no balance column in this model.
model Invoice {
  /// Public identifier that appears in the payment URL: /pay/{id}
  id String @id

  /// keccak256 of the invoice id — the contract's per-payee salt.
  salt     String
  /// Deterministic id of the escrow in the contract, derivable before the escrow exists.
  escrowId String

  chainId       Int
  escrowAddress String
  tokenAddress  String
  tokenSymbol   String
  tokenDecimals Int

  /// Freelancer receiving the funds. Verified by signature at creation.
  payeeAddress    String
  /// Client expected to pay. Null for an open link that anybody may fund.
  payerAddress    String?
  /// Address that actually funded the escrow, once observed on chain.
  fundedByAddress String?

  /// Amount in token base units, as a decimal string — never a float.
  amount      String
  description String
  /// Commitment to the terms above, also stored on chain so the client can verify the link.
  detailsHash String

  /// Seconds between funding and expiry.
  protectionPeriod Int
  fundingDeadline  DateTime?

  /// Signature by payeeAddress over the creation message, proving they published this link.
  creationSignature String

  /// Last status observed on chain. Advisory only.
  indexedStatus String    @default("AWAITING_CHAIN")
  indexedAt     DateTime?
  indexedBlock  BigInt?

  /// Funding time and expiry as recorded by the contract, mirrored for listing and sorting.
  fundedAt  DateTime?
  expiresAt DateTime?

  /// Transaction hashes reported by clients, shown as links. The chain remains the authority.
  createTxHash String?
  fundTxHash   String?
  settleTxHash String?

  /// Registry key of the chain this escrow lives on (`base-sepolia`, `solana-devnet`, …).
  /// Nullable because rows predating multi-chain carry only the numeric EVM chainId.
  chainKey String?

  /// Set when this escrow is the payment for a Job. The invoice flow works without one.
  jobId String? @unique
  job   Job?    @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, escrowId])
  @@index([payeeAddress, createdAt])
  @@index([payerAddress, createdAt])
  @@index([indexedStatus])
  @@index([chainId, expiresAt])
}

/// A Vaulted account, backed by a Twitter/X identity.
///
/// The handle is not self-asserted: it comes from the OAuth provider, so `@alice` on Vaulted is the
/// same `@alice` on Twitter. Wallets are separate and each needs its own signature — logging in
/// proves who you are, signing proves which wallet is yours, and payments need the second.
///
/// Mapped onto the original `Username` table so no data or table is dropped.
model Account {
  id String @id @default(cuid())

  /// Immutable Twitter/X user id. The handle can change; this cannot.
  twitterId   String? @unique
  /// Lowercased handle, stored without the leading `@`.
  name        String  @unique
  displayName String?
  avatarUrl   String?

  /// Primary wallet, once one has been linked and proven.
  ownerAddress   String?
  ownerChainKey  String?
  /// Signature that proved the primary wallet. Retained so the link stays auditable.
  claimSignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     LinkedWallet[]
  notifications Notification[]

  @@index([ownerAddress])
  @@map("Username")
}

/// One verified wallet per chain for an account, so `@alice` resolves differently per network.
///
/// A row exists only once a signature proved control of the address. Unverified addresses are
/// rejected rather than stored as pending — an unproven mapping would misdirect real money.
model LinkedWallet {
  id         String @id @default(cuid())
  usernameId String

  chainKey String
  address  String

  proofSignature String
  verifiedAt     DateTime @default(now())

  account Account @relation(fields: [usernameId], references: [id], onDelete: Cascade)

  @@unique([usernameId, chainKey])
  @@unique([chainKey, address])
  @@index([address])
  @@map("UsernameAddress")
}

/// In-app notification. Written when something real happens, never speculatively.
model Notification {
  id        String @id @default(cuid())
  accountId String

  /// JOB_POSTED | JOB_APPLICATION | JOB_HIRED | JOB_DECLINED
  type  String
  title String
  body  String

  /// Where the notification points.
  href String?

  jobId     String?
  invoiceId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, readAt, createdAt])
  @@index([accountId, createdAt])
}

/// A funded piece of work. Jobs sit alongside invoices rather than replacing them: accepting an
/// applicant produces an ordinary escrow, so the settlement path is the one already in production.
model Job {
  id String @id

  title       String
  description String

  /// Budget in base units of the chain's escrow token — never a float.
  budgetAmount  String
  chainKey      String
  tokenSymbol   String
  tokenDecimals Int

  deadline         DateTime?
  /// Protection window, in seconds, the escrow will use once funded.
  protectionPeriod Int

  /// Wallet that posted the job, proven by signature at creation.
  clientAddress   String
  clientSignature String

  /// OPEN | ASSIGNED | CANCELLED. Anything beyond assignment is derived from the escrow on chain,
  /// so this column never claims a payment state the chain has not confirmed.
  status String @default("OPEN")

  /// Applicant the client accepted, if any.
  assignedTo String?

  /// Work handed in by the assignee. Off-chain by nature — the contract has no concept of
  /// "delivered", and payment still requires the client to release on chain.
  submittedAt     DateTime?
  submissionNote  String?
  /// Newline-separated links to the delivered work.
  submissionLinks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications JobApplication[]
  invoice      Invoice?

  @@index([status, createdAt])
  @@index([clientAddress])
  @@index([assignedTo])
}

/// A freelancer applying to a Job. Signed, so an application cannot be filed in someone else's name.
model JobApplication {
  id    String @id @default(cuid())
  jobId String

  applicantAddress String
  message          String
  signature        String

  /// PENDING | ACCEPTED | DECLINED
  status String @default("PENDING")

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantAddress])
  @@index([applicantAddress])
}
